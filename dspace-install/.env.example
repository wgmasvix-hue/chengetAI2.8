# ============================================================================
# Bulawayo Polytechnic — DSpace 7.6 Installation Configuration
# Copy this file to .env and fill in DB_PASSWORD before running install.sh
# ============================================================================

# ── Institution ──────────────────────────────────────────────────────────────
INSTITUTION_NAME="Bulawayo Polytechnic"
INSTITUTION_SHORT="BPoly"
INSTITUTION_COUNTRY="ZW"
INSTITUTION_CITY="Bulawayo"
IR_HOSTNAME="ir.bpoly.ac.zw"

ADMIN_EMAIL="library@bpoly.ac.zw"
ADMIN_FIRST="Library"
ADMIN_LAST="Administrator"
ADMIN_PHONE="+263292884471"

# ── Software Versions ────────────────────────────────────────────────────────
DSPACE_VERSION="7.6.2"
DSPACE_ANGULAR_VERSION="7.6.2"
SOLR_VERSION="8.11.3"
JAVA_VERSION="17"
NODE_VERSION="18"

# ── Paths ────────────────────────────────────────────────────────────────────
DSPACE_DIR="/dspace"
BUILD_DIR="/build"

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="dspace"
DB_USER="dspace"
DB_PASSWORD=""                    # ← REQUIRED: set a strong password here

# ── Handle Server ────────────────────────────────────────────────────────────
# Register a prefix at https://www.handle.net/  (use 123456789 for testing)
HANDLE_PREFIX="123456789"

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_SERVER="localhost"
MAIL_PORT="25"
MAIL_FROM="noreply@bpoly.ac.zw"
MAIL_ALERT="it@bpoly.ac.zw"

# ── SSL / Certbot ─────────────────────────────────────────────────────────────
CERTBOT_EMAIL="it@bpoly.ac.zw"
ENABLE_SSL="true"                  # set false to skip certbot (HTTP only)

# ── Ports ────────────────────────────────────────────────────────────────────
TOMCAT_PORT="8080"
UI_PORT="4000"
SOLR_PORT="8983"
